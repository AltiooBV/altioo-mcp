{
  "name": "altioo/mcp-server-extension",
  "type": "itop-extension",
  "description": "Altioo MCP iTop Extension",
  "license": "proprietary",
  "version": "1.0.0",
  "require": {
    "php": ">=8.3 <8.4",
    "composer-runtime-api": "^2.0",
    "mcp/sdk": "^0.5.0"
  },
  "autoload": {
    "psr-4": {
      "Altioo\\iTop\\Extension\\MCP\\": "src"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "preferred-install": "dist",
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "php-http/discovery": true
    },
        "autoloader-suffix": "AltiooMcpExtension"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
