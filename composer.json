{
  "name": "altioo/mcp-server-extension",
  "type": "itop-extension",
  "description": "Model Context Protocol server for iTop: search, read and update CMDB and ticketing objects through the authenticated user's own permissions.",
  "keywords": ["itop", "mcp", "model-context-protocol", "itsm", "cmdb", "ai"],
  "license": "AGPL-3.0-or-later",
  "homepage": "https://github.com/altioo/mcp-server-extension",
  "authors": [
    {
      "name": "Altioo",
      "homepage": "https://github.com/altioo",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/altioo/mcp-server-extension/issues",
    "source": "https://github.com/altioo/mcp-server-extension",
    "docs": "https://github.com/altioo/mcp-server-extension/blob/main/README.md",
    "security": "https://github.com/altioo/mcp-server-extension/blob/main/SECURITY.md",
    "email": "security@altioo.com"
  },
  "require": {
    "php": ">=8.2 <8.5",
    "composer-runtime-api": "^2.0",
    "mcp/sdk": "^0.7.1",
    "nyholm/psr7": "^1.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Altioo\\iTop\\Extension\\MCP\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Altioo\\iTop\\Extension\\MCP\\Test\\": "tests/php-unit-tests"
    },
    "exclude-from-classmap": [
      "/tests/php-unit-tests/Support/log_doubles.php"
    ]
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "sbom": "php tools/sbom.php"
  },
  "scripts-descriptions": {
    "lint": "Checks the hand-written PHP against Combodo's coding standard (tools/phpcs/iTop). Needs phpcs on the PATH.",
    "lint:fix": "Applies the fixable half of what lint reports.",
    "sbom": "Writes a CycloneDX bill of materials for the production dependencies to stdout."
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "classmap-authoritative": true,
    "preferred-install": "dist",
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "php-http/discovery": true
    },
    "autoloader-suffix": "AltiooMcpExtension"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
