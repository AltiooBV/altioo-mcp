# Serves the MCP endpoint, and nothing else in this directory.
#
# This module's whole public surface is one PHP entry point. Everything else
# that ships with it - src/, the vendored SDK, tests/, composer.json - has no
# business being reachable over HTTP, so this denies the directory and grants
# back exactly one file.
#
# The deny is stated here rather than inherited, because the two places this
# file ends up protect different amounts on their own:
#
#   extensions/altioo-mcp/   iTop's extensions/.htaccess already denies the
#                            subtree except for a list of static asset
#                            extensions, PHP not among them. Only the grant
#                            below is needed - the deny is redundant.
#
#   env-<env>/altioo-mcp/    The setup copies this file alongside the module.
#                            The compiler writes its own .htaccess once at the
#                            env root, and that one's FilesMatch DOES include
#                            php, granted for the whole subtree. Without the
#                            deny below, every file under src/ and vendor/
#                            would be served from the compiled tree.
#
# The deny is inside a FilesMatch, and that is the load-bearing part rather
# than a style choice. Apache applies <Files>/<FilesMatch> sections after the
# plain directory-context directives of every .htaccess in the path, so a bare
# "Require all denied" here loses to the env root's FilesMatch grant on .php -
# for every file it matches, which is all of src/ and all of vendor/. Stating
# the deny in file context puts it at the same precedence as that grant, and
# this file, being the child, is applied last and wins. Observed on Apache
# 2.4.68: with the deny at directory level, src/Helper/MCPHelper.php was
# served 200 from the compiled tree while composer.json - which the root's
# FilesMatch does not match - was correctly refused.
#
# Order matters below: both sections are file context, so the grant for
# index.php must come after the deny.
#
# Keep this in step with web.config, which does the same job on IIS.

<IfModule mod_authz_core.c>
	# Apache 2.4
	<FilesMatch ".">
		Require all denied
	</FilesMatch>
	<Files "index.php">
		Require all granted
	</Files>
</IfModule>

<IfModule !mod_authz_core.c>
	# Apache 2.2
	<FilesMatch ".">
		Deny from all
		Satisfy All
	</FilesMatch>
	<Files "index.php">
		Order Allow,Deny
		Allow from all
	</Files>
</IfModule>

# Apache 2.2 and 2.4
IndexIgnore *
