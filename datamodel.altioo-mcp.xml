    <class id="AltiooEventMCPService" _delta="define">
      <parent>Event</parent>
      <properties>
        <comment><![CDATA[/**
 * Audit trail for MCP service calls.
 * Records each inbound MCP request with its method, tool/resource name,
 * execution status and any error message.
 *
 * @copyright   Copyright (C) 2026 Altioo
 * @license     https://www.gnu.org/licenses/agpl-3.0.html AGPL-3.0-or-later
 */]]></comment>
        <category>application</category>
        <abstract>false</abstract>
        <key_type>autoincrement</key_type>
        <db_table>priv_altioo_event_mcp_service</db_table>
        <db_key_field>id</db_key_field>
        <db_final_class_field/>
        <naming>
          <attributes>
            <attribute id="date"/>
            <attribute id="mcp_name"/>
          </attributes>
        </naming>
        <display_template/>
        <icon/>
        <reconciliation>
          <attributes>
            <attribute id="date"/>
          </attributes>
        </reconciliation>
      </properties>

      <fields>
        <!-- MCP method: tools/call, resources/read, prompts/get, etc. -->
        <field id="mcp_method" xsi:type="AttributeString">
          <sql>mcp_method</sql>
          <default_value/>
          <is_null_allowed>false</is_null_allowed>
          <validation_pattern/>
          <max_size>64</max_size>
        </field>

        <!-- Tool/resource/prompt name that was invoked -->
        <field id="mcp_name" xsi:type="AttributeString">
          <sql>mcp_name</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
          <validation_pattern/>
          <max_size>255</max_size>
        </field>

        <!-- Execution status: success, error -->
        <field id="status" xsi:type="AttributeEnum">
          <sql>status</sql>
          <default_value>success</default_value>
          <is_null_allowed>false</is_null_allowed>
          <values>
            <value id="success">
              <code>success</code>
              <rank>10</rank>
            </value>
            <value id="error">
              <code>error</code>
              <rank>20</rank>
            </value>
          </values>
        </field>

        <!-- Wall-clock duration of the whole request, in milliseconds -->
        <field id="duration_ms" xsi:type="AttributeInteger">
          <sql>duration_ms</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
          <validation_pattern/>
        </field>

        <!-- Size of the response body, in bytes -->
        <field id="response_bytes" xsi:type="AttributeInteger">
          <sql>response_bytes</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
          <validation_pattern/>
        </field>

        <!-- Correlates this row with the matching entry in log/error.log -->
        <field id="error_ref" xsi:type="AttributeString">
          <sql>error_ref</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
          <validation_pattern/>
          <max_size>32</max_size>
        </field>

        <!-- Raw JSON request payload for audit/debugging -->
        <field id="request_params" xsi:type="AttributeText">
          <sql>request_params</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
        </field>
      </fields>
      <methods/>

      <presentation>
        <details>
          <items>
            <item id="col:col0">
              <rank>10</rank>
              <items>
                <item id="fieldset:AltiooEventMCPService:main">
                  <rank>10</rank>
                  <items>
                    <item id="date">
                      <rank>10</rank>
                    </item>
                    <item id="userinfo">
                      <rank>20</rank>
                    </item>
                    <item id="mcp_method">
                      <rank>30</rank>
                    </item>
                    <item id="mcp_name">
                      <rank>40</rank>
                    </item>
                    <item id="status">
                      <rank>50</rank>
                    </item>
                    <item id="duration_ms">
                      <rank>60</rank>
                    </item>
                    <item id="response_bytes">
                      <rank>70</rank>
                    </item>
                  </items>
                </item>
              </items>
            </item>
            <item id="col:col1">
              <rank>20</rank>
              <items>
                <item id="fieldset:AltiooEventMCPService:details">
                  <rank>10</rank>
                  <items>
                    <item id="message">
                      <rank>10</rank>
                    </item>
                    <item id="error_ref">
                      <rank>15</rank>
                    </item>
                    <item id="request_params">
                      <rank>20</rank>
                    </item>
                  </items>
                </item>
              </items>
            </item>
          </items>
        </details>

        <list>
          <items>
            <item id="date">
              <rank>10</rank>
            </item>
            <item id="userinfo">
              <rank>20</rank>
            </item>
            <item id="mcp_method">
              <rank>30</rank>
            </item>
            <item id="mcp_name">
              <rank>40</rank>
            </item>
            <item id="status">
              <rank>50</rank>
            </item>
          </items>
        </list>
      </presentation>
    </class>
