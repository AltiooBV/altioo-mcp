  <user_rights>
    <profiles>
      <!--
        Gate-only profile, modelled on core's "REST Services User" (id 1024 in
        core/datamodel.core.xml): it grants no class rights of its own, it only
        marks the users allowed through the MCP endpoint. Actual data access
        still comes from the user's other profiles.
        The id must stay unique across every module installed on the target
        iTop - Combodo currently occupies 2..12, 117 and 1024.
      -->
      <profile id="2100" _delta="define">
        <name>MCP Services User</name>
        <description>Only users having this profile are allowed to use the MCP services (unless 'secure_mcp_services' is set to false in the module configuration).</description>
        <groups/>
      </profile>
    </profiles>
  </user_rights>
  <module_parameters>
    <parameters id="altioo-mcp" _delta="define">
      <secure_mcp_services type="bool">true</secure_mcp_services>
      <!--
        Origins allowed to read MCP responses from a browser. Empty means no
        Access-Control-Allow-Origin header is sent at all, which is what a
        token-authenticated endpoint called from a backend wants. Never use "*".
      -->
      <mcp_allowed_origins type="array"/>
      <!--
        Hostnames this endpoint answers to, checked against Origin - or against
        Host when there is no Origin - before the request has any side effect,
        and again by the SDK's own DNS-rebinding middleware. Empty is not "no
        check": it means the list is derived from app_root_url plus the
        localhost variants plus whatever mcp_allowed_origins already names.
        Write hostnames without a port. The single entry "*" turns the check
        off, which is the honest answer for an instance whose app_root_url uses
        iTop's %SERVER_NAME% placeholder or that sits behind a proxy validating
        Host itself.
      -->
      <mcp_allowed_hosts type="array"/>
      <mcp_allowed_profiles type="array">
        <item>Administrator</item>
        <item>MCP Services User</item>
      </mcp_allowed_profiles>
      <!--
        Kill switch, evaluated whatever the extension that registered the
        element: list tool names, prompt names, resource URIs or resource
        template URIs. What is listed here is neither advertised nor callable.
        Empty means nothing is turned off.
      -->
      <mcp_disabled_tools type="array"/>
      <!--
        Toolsets this instance serves. A toolset is the functional group an
        element declares - the base extension ships "datamodel", "objects",
        "relations", "documents", "history" and "server", each with a matching
        MCP-toolset-<name> token scope, and a pack declares its own. Empty
        means every toolset, which is what an instance that has not been asked
        to narrow wants.
        Every element the base registers declares one. An element that declares
        none falls back to its namespace, which is a name for who wrote it
        rather than for what it does - so a pack that leaves getToolset() alone
        is narrowed by its own vendor name, which is probably not what its
        operator expects to be typing here.
        Listing them is the positive counterpart to mcp_disabled_tools: a tool
        an update adds to a pack is then off until someone says otherwise.
      -->
      <mcp_enabled_toolsets type="array"/>
      <!--
        What this instance allows, for everyone: any of "read", "write" and
        "delete". A tool falls into one of the three by what its annotations
        declare, so a pack is graded by describing its tools rather than by
        being listed here. Empty means all three.
        The per-token equivalent is the MCP-read / MCP-write / MCP-delete
        token scopes, which narrow one credential rather than the instance.
      -->
      <mcp_capabilities type="array"/>
      <!--
        Shorthand for mcp_capabilities = array('read'). Turning the whole
        endpoint read-only is the thing an operator wants to do in one line
        and without looking anything up.
      -->
      <mcp_read_only type="bool">false</mcp_read_only>
      <!--
        Whether the classes that decide what a caller may do - PersonalToken,
        UserToken, User and iTop's URP_ rights model - may be written through
        this endpoint. Off by default: no ordinary assistant workflow mints a
        token or grants a profile, and a caller able to write these can widen
        the credential it was handed.
        On, the caller may administer other people's access. It can still
        never touch its own - not the token it authenticated with, not another
        of its own, not its own account or profiles - and that guard does not
        read this setting.
      -->
      <mcp_allow_access_administration type="bool">false</mcp_allow_access_administration>
      <!--
        Whether this endpoint may write iTop's automation - Trigger, Action,
        the links between them and the RemoteApplicationConnection a webhook
        calls through. Off by default. A trigger with an action behind it is a
        standing instruction: it fires on changes made by anyone, from inside
        iTop's own request handling, long after the session that wrote it has
        gone - and no tool here can send mail or call a URL directly, so there
        is no rights answer that makes staging one equivalent to doing it.
        On, an operator has decided an assistant may wire up notifications and
        webhooks. Reading is unaffected either way.
      -->
      <mcp_allow_automation_administration type="bool">false</mcp_allow_automation_administration>
      <!--
        Elements per tools/list, resources/list or prompts/list page. The MCP
        SDK defaults to 50 and pages the rest behind a cursor, which a client
        that ignores nextCursor never asks for: the 51st tool then exists and
        is callable, but is advertised to nobody. High enough that a normal
        installation is one page.
      -->
      <mcp_pagination_limit type="integer">200</mcp_pagination_limit>
      <!--
        Largest document served or accepted through this endpoint, in bytes.
        Reading an object never returns file content - it returns the name, the
        type, the size and the URI - so this bounds the one call that does ask
        for a file, in both directions. 5 MB of file is about 6.7 MB of JSON
        once base64-encoded, which is most of a context window spent on one
        document; raise it for an instance whose users genuinely need larger
        files read, and remember that PHP's upload_max_filesize and
        post_max_size still apply on the way in.
      -->
      <mcp_max_document_bytes type="integer">5242880</mcp_max_document_bytes>
      <!--
        URL of the RFC 9728 protected-resource metadata document, served by
        the OAuth-terminating proxy in front of iTop when there is one. It is
        advertised in the WWW-Authenticate header of a 401, which is how a
        client that only offers a "Connect" button finds the authorization
        server. This module implements no OAuth itself. Empty means the
        challenge carries no such pointer.
      -->
      <mcp_protected_resource_metadata type="string"></mcp_protected_resource_metadata>
      <!--
        Where a caller is told to obtain the corresponding source of what this
        instance is serving, reported by the core/version resource. Empty means
        upstream (MCPHelper::SOURCE_URL), which is right for an unmodified
        install. Set it if you modified this module and third parties reach it
        over a network: AGPL 13 entitles them to the source of the version
        actually running, and upstream is no longer that.
      -->
      <mcp_source_url type="string"></mcp_source_url>
      <log_mcp_service type="bool">true</log_mcp_service>
      <!--
        The MCP methods that earn an audit row. This list is what an installed
        instance actually filters against - MCPHelper::DEFAULT_LOG_METHODS is
        only the fallback for a configuration that does not declare the
        parameter at all - so a method missing here is a method missing from
        the trail on every install. "initialize" is the one record that a
        client connected: without it the trail answers what was called and
        never who arrived. "exceptions" is the pseudo-method stamped on a
        request that died before its JSON-RPC method could be read.
      -->
      <log_mcp_method type="array">
        <item>initialize</item>
        <item>resources/read</item>
        <item>tools/call</item>
        <item>prompts/get</item>
        <item>exceptions</item>
      </log_mcp_method>
      <log_mcp_level type="enum">
        <value id="info">info</value>
        <value id="debug">debug</value>
        <value id="error" default="true">error</value>
      </log_mcp_level>
    </parameters>
  </module_parameters>
</itop_design>
