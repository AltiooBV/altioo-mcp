    <class id="AltiooEventMCPService" _delta="define">
      <parent>Event</parent>
      <properties>
        <comment><![CDATA[/**
 * Audit trail for MCP service calls.
 * Records each inbound MCP request with its method, tool/resource name,
 * execution status and any error message.
 *
 * @copyright   Copyright (C) 2026 Altioo
 * @license     https://www.gnu.org/licenses/agpl-3.0.html AGPL-3.0-or-later
 */]]></comment>
        <category>application</category>
        <abstract>false</abstract>
        <key_type>autoincrement</key_type>
        <db_table>priv_altioo_event_mcp_service</db_table>
        <db_key_field>id</db_key_field>
        <db_final_class_field/>
        <naming>
          <attributes>
            <attribute id="date"/>
            <attribute id="mcp_name"/>
          </attributes>
        </naming>
        <display_template/>
        <icon/>
        <reconciliation>
          <attributes>
            <attribute id="date"/>
          </attributes>
        </reconciliation>
      </properties>

      <fields>
        <!-- MCP method: tools/call, resources/read, prompts/get, etc. -->
        <field id="mcp_method" xsi:type="AttributeString">
          <sql>mcp_method</sql>
          <default_value/>
          <is_null_allowed>false</is_null_allowed>
          <validation_pattern/>
          <max_size>64</max_size>
        </field>

        <!-- Tool/resource/prompt name that was invoked -->
        <field id="mcp_name" xsi:type="AttributeString">
          <sql>mcp_name</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
          <validation_pattern/>
          <max_size>255</max_size>
        </field>

        <!--
          The portal that served the call, empty for a console call. A portal
          user allowed into several is served one per connection, named by
          the endpoint URL's portal_id (doc/adr/0007).
        -->
        <field id="portal" xsi:type="AttributeString">
          <sql>portal</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
          <validation_pattern/>
          <max_size>64</max_size>
        </field>

        <!--
          The client that made the call, as it declared itself: the name and
          version of `clientInfo` on an `initialize` request, or of
          `_meta["io.modelcontextprotocol/clientInfo"]` on any request of a
          2026-07-28 client, which never sends `initialize`. Free text written
          by the caller and verified by nobody: it identifies a well-behaved
          client, it does not authenticate one. Empty on a row from a client
          that sends neither, which an older one need not: the endpoint is
          stateless, so there is no session to remember it from.
        -->
        <field id="client" xsi:type="AttributeString">
          <sql>client</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
          <validation_pattern/>
          <max_size>255</max_size>
        </field>

        <!-- Execution status: success, error -->
        <field id="status" xsi:type="AttributeEnum">
          <sql>status</sql>
          <default_value>success</default_value>
          <is_null_allowed>false</is_null_allowed>
          <values>
            <value id="success">
              <code>success</code>
              <rank>10</rank>
            </value>
            <value id="error">
              <code>error</code>
              <rank>20</rank>
            </value>
          </values>
        </field>

        <!--
          Whether this call was a dry run. Without it a later review of this
          log cannot tell a rehearsal from a real write - the parameters are
          only stored at debug level - which is exactly the question such a
          review is asking. "n/a" for a call that has no dry run to speak of:
          a read, a handshake, anything that is not a write tool.
        -->
        <field id="simulate" xsi:type="AttributeEnum">
          <sql>simulate</sql>
          <default_value>n/a</default_value>
          <is_null_allowed>false</is_null_allowed>
          <values>
            <value id="yes">
              <code>yes</code>
              <rank>10</rank>
            </value>
            <value id="no">
              <code>no</code>
              <rank>20</rank>
            </value>
            <value id="n/a">
              <code>n/a</code>
              <rank>30</rank>
            </value>
          </values>
        </field>

        <!--
          The account the call ran as: a stable key where `userinfo` is a login
          string, which a rename changes and a deletion loses, as
          CMDBChange.user_id is for a change. Set from the real user under
          impersonation, as CMDBChange does. Nullable: a row from before this
          column, and a refusal before any account was known, hold none.

          DEL_AUTO, the same as the token links below: deleting the user is not
          blocked by these rows, and the rows survive it with `userinfo` intact
          and this key reset. iTop does that reset one row at a time inside the
          request that deletes the user - measured at about 2 ms a row on 3.2.3
          (1000 rows, 2 s) - so deleting an account with a very long history is
          slow. DEL_MANUAL does exactly the same on a nullable key; DEL_NONE
          would skip it and leave the key pointing at a user who is gone, which
          the maintainer chose against.
        -->
        <field id="user_id" xsi:type="AttributeExternalKey">
          <sql>user_id</sql>
          <dependencies/>
          <is_null_allowed>true</is_null_allowed>
          <allow_target_creation>false</allow_target_creation>
          <target_class>User</target_class>
          <on_target_delete>DEL_AUTO</on_target_delete>
        </field>

        <!--
          Which credential authenticated the call. Exactly one of these is set,
          and which one is the answer: iTop's two token classes are siblings -
          PersonalToken and UserToken both descend from cmdbAbstractObject, not
          from a common token class - so there is no single external key that
          could point at either, and the populated field is the discriminator.
          Neither set means the request did not authenticate with a token.

          Both are nullable, and that is the part doing the work: a nullable
          external key is *reset* when its target is deleted, not cascaded
          (DBObject::MakeDeletionPlan, "Optional external key, list to reset").
          Tokens are rebuilt and revoked as a matter of routine - there is a
          REBUILD TOKEN button on that very screen - and an audit row that
          vanished with the credential it recorded would be an audit trail the
          audited party can clear by rotating a token.

          `userinfo` above stays for the same reason: the key is the
          convenience, the inherited string is the record, and it still names
          the caller after the token object is gone.
        -->
        <field id="user_token_id" xsi:type="AttributeExternalKey">
          <sql>user_token_id</sql>
          <dependencies/>
          <is_null_allowed>true</is_null_allowed>
          <allow_target_creation>false</allow_target_creation>
          <target_class>UserToken</target_class>
          <on_target_delete>DEL_AUTO</on_target_delete>
        </field>

        <field id="personal_token_id" xsi:type="AttributeExternalKey">
          <sql>personal_token_id</sql>
          <dependencies/>
          <is_null_allowed>true</is_null_allowed>
          <allow_target_creation>false</allow_target_creation>
          <target_class>PersonalToken</target_class>
          <on_target_delete>DEL_AUTO</on_target_delete>
        </field>

        <!--
          The change this request made, when it made one. Null for a read and
          null for a dry run, which is information rather than an absence - it
          agrees with `simulate` and disagreeing with it would be the finding.

          One request produces at most one CMDBChange: ChangeTracking::ForRequest()
          calls CMDBObject::SetCurrentChange(null) once per request and iTop
          then creates one lazily on the first write and reuses it, so a bulk
          call writing fifty objects sits under this single change.
        -->
        <field id="change_id" xsi:type="AttributeExternalKey">
          <sql>change_id</sql>
          <dependencies/>
          <is_null_allowed>true</is_null_allowed>
          <allow_target_creation>false</allow_target_creation>
          <target_class>CMDBChange</target_class>
          <on_target_delete>DEL_AUTO</on_target_delete>
        </field>

        <!--
          What the change touched, in readable form, denormalised on purpose.
          The key above is the live drill-down; this is the part that survives
          a retention purge of CMDBChange, which doc/security-summary.md says
          is the operator's to set. Without it, purging the change turns every
          historical row back into "a write succeeded" with no subject.
        -->
        <field id="changed_objects" xsi:type="AttributeText">
          <sql>changed_objects</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
        </field>

        <!--
          Why the caller said it was making the change: the optional `comment`
          of the writing tools, as one line cut to the column. It used to be
          written into the change's `userinfo` after the user's name; it is
          here so that line stays the plain name the personal data anonymizer
          matches (doc/adr/0009). Free text written by the caller, so it may
          name people; it is cleared with `request_params` when the account's
          person is anonymised, and goes with the row at retention. Empty for a
          call that gave no reason.
        -->
        <field id="change_comment" xsi:type="AttributeString">
          <sql>change_comment</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
          <validation_pattern/>
          <max_size>255</max_size>
        </field>

        <!--
          What a read returned, as class and id only: `UserRequest: 12, 15
          (+41 more); Person: 7`. Never a value and never a name, so this row
          still does not record what the objects contain. The counterpart of
          `changed_objects` for the calls that write nothing, kept for the
          question a data owner asks afterwards: was this ticket sent to a
          model? Not written at all at the `error` log level, which skips
          successful rows.
        -->
        <field id="read_objects" xsi:type="AttributeText">
          <sql>read_objects</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
        </field>

        <!-- Wall-clock duration of the whole request, in milliseconds -->
        <field id="duration_ms" xsi:type="AttributeInteger">
          <sql>duration_ms</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
          <validation_pattern/>
        </field>

        <!-- Size of the response body, in bytes -->
        <field id="response_bytes" xsi:type="AttributeInteger">
          <sql>response_bytes</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
          <validation_pattern/>
        </field>

        <!-- Correlates this row with the matching entry in log/error.log -->
        <field id="error_ref" xsi:type="AttributeString">
          <sql>error_ref</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
          <validation_pattern/>
          <!--
            Room for more than one. A call mints a reference per failure, and a
            bulk call can fail several rows - at 32 only the first fitted, so a
            caller quoting the third had nothing to find.
          -->
          <max_size>255</max_size>
        </field>

        <!-- Raw JSON request payload for audit/debugging -->
        <field id="request_params" xsi:type="AttributeText">
          <sql>request_params</sql>
          <default_value/>
          <is_null_allowed>true</is_null_allowed>
        </field>
      </fields>
      <methods/>

