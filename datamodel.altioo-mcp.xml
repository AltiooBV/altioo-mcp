  <user_rights>
    <profiles>
      <!--
        Gate-only profile, modelled on core's "REST Services User" (id 1024 in
        core/datamodel.core.xml): it grants no class rights of its own, it only
        marks the users allowed through the MCP endpoint. Actual data access
        still comes from the user's other profiles.
        The id must stay unique across every module installed on the target
        iTop - Combodo currently occupies 2..12, 117 and 1024.
      -->
      <profile id="2100" _delta="define">
        <name>MCP Services User</name>
        <description>Only users having this profile are allowed to use the MCP services (unless 'secure_mcp_services' is set to false in the module configuration).</description>
        <groups/>
      </profile>
    </profiles>
  </user_rights>
  <module_parameters>
    <parameters id="altioo-mcp" _delta="define">
      <secure_mcp_services type="bool">true</secure_mcp_services>
      <!--
        Origins allowed to read MCP responses from a browser. Empty means no
        Access-Control-Allow-Origin header is sent at all, which is what a
        token-authenticated endpoint called from a backend wants. Never use "*".
      -->
      <mcp_allowed_origins type="array"/>
      <mcp_allowed_profiles type="array">
        <item>Administrator</item>
        <item>MCP Services User</item>
      </mcp_allowed_profiles>
      <!--
        Kill switch, evaluated whatever the extension that registered the
        element: list tool names, prompt names, resource URIs or resource
        template URIs. What is listed here is neither advertised nor callable.
        Empty means nothing is turned off.
      -->
      <mcp_disabled_tools type="array"/>
      <!--
        Elements per tools/list, resources/list or prompts/list page. The MCP
        SDK defaults to 50 and pages the rest behind a cursor, which a client
        that ignores nextCursor never asks for: the 51st tool then exists and
        is callable, but is advertised to nobody. High enough that a normal
        installation is one page.
      -->
      <mcp_pagination_limit type="integer">200</mcp_pagination_limit>
      <log_mcp_service type="bool">true</log_mcp_service>
      <log_mcp_method type="array">
        <item>resources/read</item>
        <item>tools/call</item>
        <item>prompts/get</item>
        <item>exceptions</item>
      </log_mcp_method>
      <log_mcp_level type="enum">
        <value id="info">info</value>
        <value id="debug">debug</value>
        <value id="error" default="true">error</value>
      </log_mcp_level>
    </parameters>
  </module_parameters>
