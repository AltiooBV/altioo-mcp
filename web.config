<?xml version="1.0" encoding="utf-8" ?>
<!--
	The IIS twin of this module's .htaccess.

	iTop's extensions/web.config allows only a list of static file extensions
	under extensions/, PHP not among them, so the MCP endpoint is unreachable
	without this. .php is allowed back for this directory, and the folders that
	must never be served - the sources, the vendored SDK, the tests - are hidden
	explicitly, since requestFiltering allows an extension for the whole subtree
	rather than for one file.
-->
<configuration>
  <system.webServer>
      <security>
         <requestFiltering>
            <fileExtensions applyToWebDAV="false" allowUnlisted="false" >
               <add fileExtension=".php" allowed="true" />
            </fileExtensions>
            <hiddenSegments>
               <add segment="src" />
               <add segment="vendor" />
               <add segment="tests" />
               <add segment="templates" />
               <add segment="doc" />
            </hiddenSegments>
         </requestFiltering>
      </security>
  </system.webServer>
</configuration>
