<?xml version="1.0" encoding="utf-8" ?>
<!--
	The IIS twin of this module's .htaccess, and it must stay in step with it.

	iTop's extensions/web.config allows only a list of static file extensions
	under extensions/, PHP not among them, so the MCP endpoint is unreachable
	without this file. But the compiled copy in env-<env>/altioo-mcp/ sits under
	a configuration that does allow PHP for the whole subtree, so this cannot
	simply allow .php and rely on a parent to deny the rest.

	So: nothing is served by default - allowUnlisted="false" with no extension
	listed denies every request - and .php is granted back for the one file that
	is this module's entire public surface. The hiddenSegments are belt and
	braces for the directories that must never be reachable whatever else
	changes here.
-->
<configuration>
  <system.webServer>
      <security>
         <requestFiltering>
            <!-- No extension listed, so every extension is denied. -->
            <fileExtensions applyToWebDAV="false" allowUnlisted="false" />
            <hiddenSegments>
               <add segment="src" />
               <add segment="vendor" />
               <add segment="tests" />
               <add segment="doc" />
               <add segment="assets" />
               <add segment="templates" />
            </hiddenSegments>
         </requestFiltering>
      </security>
  </system.webServer>

  <!-- The one file this module serves. -->
  <location path="index.php">
    <system.webServer>
        <security>
           <requestFiltering>
              <fileExtensions applyToWebDAV="false" allowUnlisted="false">
                 <add fileExtension=".php" allowed="true" />
              </fileExtensions>
           </requestFiltering>
        </security>
    </system.webServer>
  </location>
</configuration>
