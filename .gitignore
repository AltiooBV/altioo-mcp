# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Composer
# vendor/* rather than vendor/ so that vendor/.gitkeep can be re-included below:
# git cannot un-ignore a file whose parent directory is itself ignored.
vendor/*
!vendor/.gitkeep
composer.phar

# The example pack resolves its own dependencies when somebody follows its
# README. A pattern with a slash in it is anchored to this file's directory, so
# the rule above does not reach here. Its lock is deliberately not committed:
# the pack is a template, and a lock in doc/ would pin the versions a reader
# gets to whatever was current when it was last touched.
/doc/example-pack/vendor/
/doc/example-pack/composer.lock
/doc/example-pack/.phpunit.result.cache
/doc/example-pack/.phpunit.cache/

# The pinned scanner security.yml runs, and that tools/ci/local/Dockerfile
# installs into the local runner image. Anchored for the same reason as the
# block above. Its lock, unlike the example pack's, *is* committed and must
# stay that way: pinning the scanner's fifteen transitive dependencies is the
# whole point of the project existing rather than a `composer global require`.
/tools/ci/local/progpilot/vendor/

# PHPStorm / IDEs
.idea/
*.iml
.vscode/

# .claude/settings.json IS committed - the project hooks belong to everyone who
# clones this. Only the personal overrides beside it are not.
.claude/settings.local.json

# Python bytecode, written beside tools/reconcile-since.py whenever it runs.
__pycache__/

# Review findings name real gaps, so they stay on the machine that wrote them.
# The persona list beside them is tracked: it is what a review runs, and it
# says nothing SECURITY.md's threat model does not already publish.
/review/*
!/review/review-personas.md

# PHPUnit
.phpunit.result.cache
.phpunit.cache/
phpunit.xml

# Release build products. Generated by .github/workflows/release.yml from the
# lock file and attached to the release, so a copy in the tree would only ever
# be a stale one.
/build/
/sbom.cyclonedx.json
/licenses.json
/altioo-mcp-*.zip
/altioo-mcp-*.zip.sha256

# The model-run harness resolves its own dependencies (tools/evals/composer.json).
/tools/evals/vendor/
/tools/evals/composer.lock
