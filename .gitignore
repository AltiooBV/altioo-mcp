# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes

# Composer
# vendor/* rather than vendor/ so that vendor/.gitkeep can be re-included below:
# git cannot un-ignore a file whose parent directory is itself ignored.
vendor/*
!vendor/.gitkeep
composer.phar

# The example pack resolves its own dependencies when somebody follows its
# README. A pattern with a slash in it is anchored to this file's directory, so
# the rule above does not reach here. Its lock is deliberately not committed:
# the pack is a template, and a lock in doc/ would pin the versions a reader
# gets to whatever was current when it was last touched.
/doc/example-pack/vendor/
/doc/example-pack/composer.lock
/doc/example-pack/.phpunit.result.cache
/doc/example-pack/.phpunit.cache/

# Same case, same reason: a Composer-installed copy of a CI tool kept outside
# the project's own require-dev (ci.yml's progpilot job does this with a
# COMPOSER_HOME under $RUNNER_TEMP, precisely so it cannot be mistaken for a
# project dependency), landed under tools/ci/local/ for reproducing that job
# locally. Build tooling, not something this repository ships or should track.
/tools/ci/local/progpilot/

# PHPStorm / IDEs
.idea/
*.iml
.vscode/

# .claude/settings.json IS committed - the project hooks belong to everyone who
# clones this. Only the personal overrides beside it are not.
.claude/settings.local.json

# PHPUnit
.phpunit.result.cache
.phpunit.cache/
phpunit.xml

# Release build products. Generated by .github/workflows/release.yml from the
# lock file and attached to the release, so a copy in the tree would only ever
# be a stale one.
/build/
/sbom.cyclonedx.json
/licenses.json
/altioo-mcp-*.zip
/altioo-mcp-*.zip.sha256
